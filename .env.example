# BuilderForge Environment Configuration
# Copy this to .env and fill in your keys

# --- LLM API Keys ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here  # Optional fallback

# --- Supabase (Optional - for auth + data persistence) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# --- OKX Web3 Integration ---
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase
OKX_PROJECT_ID=your-okx-project-id

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# --- App Config ---
APP_NAME=BuilderForge
APP_VERSION=1.0.0
DEBUG=true
