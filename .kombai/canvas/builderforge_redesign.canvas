      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');\n\n  :root {\n    --bg-main: #050505;\n    --bg-surface: #111111;\n    --accent-orange: #FF4D00;\n    --accent-orange-light: #FF8C00;\n    --text-primary: #FFFFFF;\n    --text-secondary: #A1A1AA;\n  }\n\n  body {\n    background-color: var(--bg-main);\n    color: var(--text-primary);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .mesh-gradient {\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: 60%;\n    height: 100%;\n    background: radial-gradient(circle at 70% 30%, rgba(255, 77, 0, 0.15) 0%, transparent 60%),\n                radial-gradient(circle at 40% 60%, rgba(255, 140, 0, 0.08) 0%, transparent 50%);\n    filter: blur(80px);\n    z-index: -1;\n  }\n\n  .feature-card:hover {\n    background-color: rgba(255, 77, 0, 0.02);\n  }\n\n  .cta-button {\n    position: relative;\n    overflow: hidden;\n  }\n\n  .cta-button::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 100%;\n    height: 100%;\n    background: var(--accent-orange);\n    transform: translate(-50%, -50%) scale(0);\n    opacity: 0.1;\n    transition: transform 0.4s ease, opacity 0.4s ease;\n    border-radius: 50%;\n    z-index: -1;\n  }\n\n  .cta-button:hover::after {\n    transform: translate(-50%, -50%) scale(2);\n    opacity: 0.2;\n  }\n\n  .cta-button:hover {\n    box-shadow: 0 0 20px rgba(255, 77, 0, 0.3);\n  }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\">\n<div class=\"flex min-h-screen\" data-kid=\"2\" data-name=\"page layout container\">\n    \n    <aside class=\"fixed h-full w-20 flex flex-col items-center py-8 border-r border-white/5 bg-black/50 backdrop-blur-xl z-50\" data-kid=\"2-1\" data-name=\"sidebar navigation container\">\n        <div class=\"mb-12\" data-kid=\"2-1-1\" data-name=\"sidebar logo wrapper\">\n            <div class=\"w-10 h-10 bg-gradient-to-br from-[#FF4D00] to-[#FF8C00] rounded-lg flex items-center justify-center shadow-lg shadow-orange-500/20\" data-kid=\"2-1-1-1\" data-name=\"sidebar logo icon container\">\n                <i class=\"ti ti-hammer text-white text-xl\" data-kid=\"2-1-1-1-1\" data-name=\"hammer icon\">\n                </i>\n            </div>\n        </div>\n        <nav class=\"flex flex-col gap-8\" data-kid=\"2-1-2\" data-name=\"navigation menu links\">\n            <a class=\"text-[#FF4D00] transition-colors\" data-kid=\"2-1-2-1\" data-name=\"home navigation link\" href=\"#\">\n                <i class=\"ti ti-smart-home text-2xl\" data-kid=\"2-1-2-1-1\" data-name=\"home icon\">\n                </i>\n            </a>\n            <a class=\"text-white/40 hover:text-white transition-colors\" data-kid=\"2-1-2-2\" data-name=\"add project navigation link\" href=\"#\">\n                <i class=\"ti ti-plus text-2xl\" data-kid=\"2-1-2-2-1\" data-name=\"plus icon\">\n                </i>\n            </a>\n            <a class=\"text-white/40 hover:text-white transition-colors\" data-kid=\"2-1-2-3\" data-name=\"dashboard navigation link\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"2-1-2-3-1\" data-name=\"layout dashboard icon\">\n                </i>\n            </a>\n            <a class=\"text-white/40 hover:text-white transition-colors\" data-kid=\"2-1-2-4\" data-name=\"briefcase navigation link\" href=\"#\">\n                <i class=\"ti ti-briefcase text-2xl\" data-kid=\"2-1-2-4-1\" data-name=\"briefcase icon\">\n                </i>\n            </a>\n            <a class=\"text-white/40 hover:text-white transition-colors\" data-kid=\"2-1-2-5\" data-name=\"rocket navigation link\" href=\"#\">\n                <i class=\"ti ti-rocket text-2xl\" data-kid=\"2-1-2-5-1\" data-name=\"rocket icon\">\n                </i>\n            </a>\n        </nav>\n        <div class=\"mt-auto\" data-kid=\"2-1-3\" data-name=\"settings link container\">\n            <a class=\"text-white/20 hover:text-white transition-colors\" data-kid=\"2-1-3-1\" data-name=\"settings navigation link\" href=\"#\">\n                <i class=\"ti ti-settings text-xl\" data-kid=\"2-1-3-1-1\" data-name=\"settings icon\">\n                </i>\n            </a>\n        </div>\n    </aside>\n    \n    <main class=\"ml-20 flex-1 relative px-12 lg:px-24\" data-kid=\"2-2\" data-name=\"main content container\">\n        <div class=\"mesh-gradient\" data-kid=\"2-2-1\" data-name=\"background mesh gradient\">\n        </div>\n        \n        <header class=\"h-24 flex items-center justify-between\" data-kid=\"2-2-2\" data-name=\"page header\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-2-1\" data-name=\"header brand name container\">\n                <span class=\"text-xs font-medium tracking-[0.3em] uppercase text-white/40\" data-kid=\"2-2-2-1-1\" data-name=\"brand name text\">\n                    BuilderForge\n                </span>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"2-2-2-2\" data-name=\"header status indicator container\">\n                <div class=\"flex items-center gap-2 px-3 py-1.5 bg-[#111111] rounded-full border border-white/5\" data-kid=\"2-2-2-2-1\" data-name=\"connection status badge\">\n                    <div class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" data-kid=\"2-2-2-2-1-1\" data-name=\"status pulse indicator\">\n                    </div>\n                    <span class=\"text-[10px] font-semibold text-white/60 tracking-wider\" data-kid=\"2-2-2-2-1-2\" data-name=\"status label text\">\n                        OKX TESTNET CONNECTED\n                    </span>\n                </div>\n            </div>\n        </header>\n        \n        <section class=\"pt-24 pb-32\" data-kid=\"2-2-3\" data-name=\"hero section\">\n            <div class=\"max-w-4xl\" data-kid=\"2-2-3-1\" data-name=\"hero content wrapper\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 mb-8\" data-kid=\"2-2-3-1-1\" data-name=\"hero tag container\">\n                    <span class=\"text-[10px] font-bold text-[#FF4D00] tracking-widest uppercase italic\" data-kid=\"2-2-3-1-1-1\" data-name=\"hero tag text\">\n                        OKX AI Genesis Hackathon MVP\n                    </span>\n                </div>\n                <h1 class=\"text-7xl lg:text-9xl font-bold tracking-tighter leading-[0.9] mb-8\" data-kid=\"2-2-3-1-2\" data-name=\"hero main headline\">\n                    BuilderForge\n                    <span class=\"text-[#FF4D00]\" data-kid=\"2-2-3-1-2-1\" data-name=\"hero headline period\">\n                        .\n                    </span>\n                </h1>\n                <p class=\"text-xl lg:text-2xl text-white/60 font-light tracking-wide max-w-2xl mb-12\" data-kid=\"2-2-3-1-3\" data-name=\"hero subheadline text\">\n                    Autonomous\n                    <span class=\"text-white font-medium\" data-kid=\"2-2-3-1-3-1\" data-name=\"highlighted subheadline text\">\n                        Idea-to-Launch\n                    </span>\n                    Agent for the OKX ecosystem. Turn concepts into products, automatically.\n                </p>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-2-3-1-4\" data-name=\"call to action group\">\n                    <button class=\"cta-button bg-white text-black px-8 py-4 rounded-md font-bold text-sm tracking-widest uppercase transition-all flex items-center gap-3\" data-kid=\"2-2-3-1-4-1\" data-name=\"initialize project button\">\n                        Initialize New Project\n                        <i class=\"ti ti-arrow-right text-lg\" data-kid=\"2-2-3-1-4-1-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </button>\n                    <a class=\"text-white/40 hover:text-white transition-colors font-medium text-sm tracking-widest uppercase border-b border-white/10 pb-1\" data-kid=\"2-2-3-1-4-2\" data-name=\"view registry link\" href=\"#\">\n                        View DealFlow Registry\n                    </a>\n                </div>\n            </div>\n        </section>\n        \n        <section class=\"py-32 border-t border-white/5\" data-kid=\"2-2-4\" data-name=\"process explanation section\">\n            <div class=\"flex items-end justify-between mb-24\" data-kid=\"2-2-4-1\" data-name=\"section header container\">\n                <div data-kid=\"2-2-4-1-1\" data-name=\"section title container\">\n                    <span class=\"text-[#FF4D00] text-xs font-bold tracking-[0.4em] uppercase mb-4 block\" data-kid=\"2-2-4-1-1-1\" data-name=\"process label text\">\n                        The Process\n                    </span>\n                    <h2 class=\"text-4xl lg:text-5xl font-bold tracking-tight\" data-kid=\"2-2-4-1-1-2\" data-name=\"section headline\">\n                        Neural Pipeline\n                    </h2>\n                </div>\n                <p class=\"text-white/40 text-sm max-w-xs text-right italic font-light\" data-kid=\"2-2-4-1-2\" data-name=\"section description text\">\n                    Five specialized agents operating in a continuous execution loop.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-5 gap-px bg-white/5 border border-white/5\" data-kid=\"2-2-4-2\" data-name=\"process steps grid\">\n                <div class=\"bg-[#050505] p-8 group transition-all\" data-kid=\"2-2-4-2-1\" data-name=\"stage 01 card\">\n                    <span class=\"text-[10px] font-bold text-white/20 mb-12 block tracking-widest uppercase\" data-kid=\"2-2-4-2-1-1\" data-name=\"stage label text\">\n                        Stage 01\n                    </span>\n                    <i class=\"ti ti-bulb text-[#FF4D00] text-3xl mb-4\" data-kid=\"2-2-4-2-1-2\" data-name=\"bulb icon\">\n                    </i>\n                    <h3 class=\"text-lg font-bold mb-2\" data-kid=\"2-2-4-2-1-3\" data-name=\"stage title\">\n                        Ingestion\n                    </h3>\n                    <p class=\"text-xs text-white/40 leading-relaxed font-light\" data-kid=\"2-2-4-2-1-4\" data-name=\"stage description\">\n                        Describe your vision and objectives to the primary coordinator agent.\n                    </p>\n                </div>\n                <div class=\"bg-[#050505] p-8 group transition-all\" data-kid=\"2-2-4-2-2\" data-name=\"stage 02 card\">\n                    <span class=\"text-[10px] font-bold text-white/20 mb-12 block tracking-widest uppercase\" data-kid=\"2-2-4-2-2-1\" data-name=\"stage label text\">\n                        Stage 02\n                    </span>\n                    <i class=\"ti ti-search text-[#FF4D00] text-3xl mb-4\" data-kid=\"2-2-4-2-2-2\" data-name=\"search icon\">\n                    </i>\n                    <h3 class=\"text-lg font-bold mb-2\" data-kid=\"2-2-4-2-2-3\" data-name=\"stage title\">\n                        Synthesis\n                    </h3>\n                    <p class=\"text-xs text-white/40 leading-relaxed font-light\" data-kid=\"2-2-4-2-2-4\" data-name=\"stage description\">\n                        Autonomous discovery of market opportunities and grant ecosystems.\n                    </p>\n                </div>\n                <div class=\"bg-[#050505] p-8 group transition-all\" data-kid=\"2-2-4-2-3\" data-name=\"stage 03 card\">\n                    <span class=\"text-[10px] font-bold text-white/20 mb-12 block tracking-widest uppercase\" data-kid=\"2-2-4-2-3-1\" data-name=\"stage label text\">\n                        Stage 03\n                    </span>\n                    <i class=\"ti ti-palette text-[#FF4D00] text-3xl mb-4\" data-kid=\"2-2-4-2-3-2\" data-name=\"palette icon\">\n                    </i>\n                    <h3 class=\"text-lg font-bold mb-2\" data-kid=\"2-2-4-2-3-3\" data-name=\"stage title\">\n                        Forge\n                    </h3>\n                    <p class=\"text-xs text-white/40 leading-relaxed font-light\" data-kid=\"2-2-4-2-3-4\" data-name=\"stage description\">\n                        Generation of tokenomics, smart contract logic, and technical assets.\n                    </p>\n                </div>\n                <div class=\"bg-[#050505] p-8 group transition-all\" data-kid=\"2-2-4-2-4\" data-name=\"stage 04 card\">\n                    <span class=\"text-[10px] font-bold text-white/20 mb-12 block tracking-widest uppercase\" data-kid=\"2-2-4-2-4-1\" data-name=\"stage label text\">\n                        Stage 04\n                    </span>\n                    <i class=\"ti ti-bolt text-[#FF4D00] text-3xl mb-4\" data-kid=\"2-2-4-2-4-2\" data-name=\"bolt icon\">\n                    </i>\n                    <h3 class=\"text-lg font-bold mb-2\" data-kid=\"2-2-4-2-4-3\" data-name=\"stage title\">\n                        Simulation\n                    </h3>\n                    <p class=\"text-xs text-white/40 leading-relaxed font-light\" data-kid=\"2-2-4-2-4-4\" data-name=\"stage description\">\n                        On-chain deployment simulation with real-time gas monitoring.\n                    </p>\n                </div>\n                <div class=\"bg-[#050505] p-8 group transition-all\" data-kid=\"2-2-4-2-5\" data-name=\"stage 05 card\">\n                    <span class=\"text-[10px] font-bold text-white/20 mb-12 block tracking-widest uppercase\" data-kid=\"2-2-4-2-5-1\" data-name=\"stage label text\">\n                        Stage 05\n                    </span>\n                    <i class=\"ti ti-chart-bar text-[#FF4D00] text-3xl mb-4\" data-kid=\"2-2-4-2-5-2\" data-name=\"chart bar icon\">\n                    </i>\n                    <h3 class=\"text-lg font-bold mb-2\" data-kid=\"2-2-4-2-5-3\" data-name=\"stage title\">\n                        Refinement\n                    </h3>\n                    <p class=\"text-xs text-white/40 leading-relaxed font-light\" data-kid=\"2-2-4-2-5-4\" data-name=\"stage description\">\n                        Final evaluation and multi-agent recommendations for launch.\n                    </p>\n                </div>\n            </div>\n        </section>\n        \n        <section class=\"py-32 border-t border-white/5\" data-kid=\"2-2-5\" data-name=\"features section\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-12\" data-kid=\"2-2-5-1\" data-name=\"features grid container\">\n                <div class=\"bg-[#111111] p-12 rounded-2xl border border-white/5 feature-card transition-all\" data-kid=\"2-2-5-1-1\" data-name=\"feature 01 card\">\n                    <div class=\"text-5xl font-bold text-white/5 mb-8 tracking-tighter italic\" data-kid=\"2-2-5-1-1-1\" data-name=\"feature index number\">\n                        01\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"2-2-5-1-1-2\" data-name=\"feature title\">\n                        Multi-Agent Swarm\n                    </h3>\n                    <p class=\"text-white/50 text-sm leading-relaxed font-light\" data-kid=\"2-2-5-1-1-3\" data-name=\"feature description\">\n                        Coordinator, Researcher, Creator, Executor, and Analyzer agents working in a synchronized CrewAI pipeline to deliver complex outputs.\n                    </p>\n                </div>\n                <div class=\"bg-[#111111] p-12 rounded-2xl border border-white/5 feature-card transition-all\" data-kid=\"2-2-5-1-2\" data-name=\"feature 02 card\">\n                    <div class=\"text-5xl font-bold text-white/5 mb-8 tracking-tighter italic\" data-kid=\"2-2-5-1-2-1\" data-name=\"feature index number\">\n                        02\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"2-2-5-1-2-2\" data-name=\"feature title\">\n                        OKX Deep Stack\n                    </h3>\n                    <p class=\"text-white/50 text-sm leading-relaxed font-light\" data-kid=\"2-2-5-1-2-3\" data-name=\"feature description\">\n                        Native OKC Testnet integration with real-time gas estimation, token deployment protocols, and Web3 wallet-ready architecture.\n                    </p>\n                </div>\n                <div class=\"bg-[#111111] p-12 rounded-2xl border border-white/5 feature-card transition-all\" data-kid=\"2-2-5-1-3\" data-name=\"feature 03 card\">\n                    <div class=\"text-5xl font-bold text-white/5 mb-8 tracking-tighter italic\" data-kid=\"2-2-5-1-3-1\" data-name=\"feature index number\">\n                        03\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"2-2-5-1-3-2\" data-name=\"feature title\">\n                        ASP Marketplace\n                    </h3>\n                    <p class=\"text-white/50 text-sm leading-relaxed font-light\" data-kid=\"2-2-5-1-3-3\" data-name=\"feature description\">\n                        Pre-configured to list on the OKX.AI marketplace with structured manifests, capability mapping, and verified metadata.\n                    </p>\n                </div>\n            </div>\n        </section>\n        \n        <section class=\"py-24 border-t border-white/5\" data-kid=\"2-2-6\" data-name=\"tech stack section\">\n            <div class=\"flex flex-col items-center gap-12\" data-kid=\"2-2-6-1\" data-name=\"tech stack container\">\n                <span class=\"text-[10px] font-bold text-white/20 tracking-[0.5em] uppercase\" data-kid=\"2-2-6-1-1\" data-name=\"tech stack label\">\n                    Engineered With\n                </span>\n                <div class=\"flex flex-wrap justify-center items-center gap-16 opacity-30 grayscale hover:grayscale-0 transition-all\" data-kid=\"2-2-6-1-2\" data-name=\"technologies list\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-6-1-2-1\" data-name=\"tech 01 item\">\n                        <i class=\"ti ti-brand-python text-2xl\" data-kid=\"2-2-6-1-2-1-1\" data-name=\"python brand icon\">\n                        </i>\n                        <span class=\"text-xs font-semibold tracking-widest uppercase\" data-kid=\"2-2-6-1-2-1-2\" data-name=\"tech label\">\n                            Python\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-6-1-2-2\" data-name=\"tech 02 item\">\n                        <i class=\"ti ti-robot text-2xl\" data-kid=\"2-2-6-1-2-2-1\" data-name=\"robot icon\">\n                        </i>\n                        <span class=\"text-xs font-semibold tracking-widest uppercase\" data-kid=\"2-2-6-1-2-2-2\" data-name=\"tech label\">\n                            CrewAI\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-6-1-2-3\" data-name=\"tech 03 item\">\n                        <i class=\"ti ti-link text-2xl\" data-kid=\"2-2-6-1-2-3-1\" data-name=\"link icon\">\n                        </i>\n                        <span class=\"text-xs font-semibold tracking-widest uppercase\" data-kid=\"2-2-6-1-2-3-2\" data-name=\"tech label\">\n                            LangChain\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-6-1-2-4\" data-name=\"tech 04 item\">\n                        <i class=\"ti ti-brain text-2xl\" data-kid=\"2-2-6-1-2-4-1\" data-name=\"brain icon\">\n                        </i>\n                        <span class=\"text-xs font-semibold tracking-widest uppercase\" data-kid=\"2-2-6-1-2-4-2\" data-name=\"tech label\">\n                            Claude 3.5\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-6-1-2-5\" data-name=\"tech 05 item\">\n                        <i class=\"ti ti-currency-ethereum text-2xl\" data-kid=\"2-2-6-1-2-5-1\" data-name=\"ethereum icon\">\n                        </i>\n                        <span class=\"text-xs font-semibold tracking-widest uppercase\" data-kid=\"2-2-6-1-2-5-2\" data-name=\"tech label\">\n                            OKX Web3\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        \n        <footer class=\"py-12 border-t border-white/5 flex items-center justify-between text-white/20\" data-kid=\"2-2-7\" data-name=\"footer bar\">\n            <div class=\"text-[10px] tracking-widest uppercase\" data-kid=\"2-2-7-1\" data-name=\"copyright text\">\n                © 2026 BuilderForge // OKX AI Genesis Hackathon\n            </div>\n            <div class=\"flex items-center gap-8\" data-kid=\"2-2-7-2\" data-name=\"footer navigation links\">\n                <a class=\"hover:text-white transition-colors\" data-kid=\"2-2-7-2-1\" data-name=\"github link\" href=\"#\">\n                    <i class=\"ti ti-brand-github text-xl\" data-kid=\"2-2-7-2-1-1\" data-name=\"github brand icon\">\n                    </i>\n                </a>\n                <a class=\"hover:text-white transition-colors text-[10px] font-bold tracking-widest uppercase\" data-kid=\"2-2-7-2-2\" data-name=\"documentation link\" href=\"#\">\n                    Documentation\n                </a>\n                <a class=\"hover:text-white transition-colors text-[10px] font-bold tracking-widest uppercase\" data-kid=\"2-2-7-2-3\" data-name=\"marketplace link\" href=\"#\">\n                    Marketplace\n                </a>\n       