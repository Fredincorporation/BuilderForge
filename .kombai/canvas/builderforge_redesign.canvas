      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --bg-main: #0A0F1C;\n    --bg-sidebar: #070B14;\n    --accent: #FF4D00;\n    --text-primary: #F8FAFC;\n    --text-secondary: #94A3B8;\n    --border: #1E293B;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--bg-main);\n    color: var(--text-primary);\n    font-family: 'Inter', sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-space { font-family: 'Space Grotesk', sans-serif; }\n\n  @keyframes pulse {\n    0% { transform: scale(1); opacity: 1; }\n    50% { transform: scale(1.1); opacity: 0.8; }\n    100% { transform: scale(1); opacity: 1; }\n  }\n  .animate-pulse-subtle { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }\n\n  .glass-card {\n    background: rgba(30, 41, 59, 0.2);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--border);\n  }\n</style>\n<div class=\"flex h-screen overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    \n    <aside class=\"w-72 bg-[#070B14] border-r border-[#1E293B] flex flex-col shrink-0\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"p-8\" data-kid=\"1-1-1\" data-name=\"sidebar header container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo group\">\n                <div class=\"w-10 h-10 bg-[#FF4D00] rounded-lg flex items-center justify-center shadow-[0_0_20px_rgba(255,77,0,0.3)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon wrapper\">\n                    <i class=\"ti ti-hammer text-white text-2xl\" data-kid=\"1-1-1-1-1-1\" data-name=\"hammer brand icon\">\n                    </i>\n                </div>\n                <span class=\"text-xl font-bold font-space tracking-tight text-white\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    BuilderForge\n                </span>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-4 space-y-1\" data-kid=\"1-1-2\" data-name=\"main navigation list\">\n            <a class=\"flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition-all duration-200\" data-kid=\"1-1-2-1\" data-name=\"navigation link item\" href=\"#\">\n                <i class=\"ti ti-smart-home text-xl\" data-kid=\"1-1-2-1-1\" data-name=\"home link icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"home link text\">\n                    Home\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-3 text-sm font-medium text-white bg-slate-800/50 rounded-xl transition-all duration-200\" data-kid=\"1-1-2-2\" data-name=\"active navigation link item\" href=\"#\">\n                <i class=\"ti ti-square-plus text-xl text-[#FF4D00]\" data-kid=\"1-1-2-2-1\" data-name=\"new project link icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"new project link text\">\n                    New Project\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition-all duration-200\" data-kid=\"1-1-2-3\" data-name=\"navigation link item\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-xl\" data-kid=\"1-1-2-3-1\" data-name=\"dashboard link icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"dashboard link text\">\n                    Dashboard\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition-all duration-200\" data-kid=\"1-1-2-4\" data-name=\"navigation link item\" href=\"#\">\n                <i class=\"ti ti-layers-intersect text-xl\" data-kid=\"1-1-2-4-1\" data-name=\"dealflow link icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"dealflow link text\">\n                    DealFlow\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition-all duration-200\" data-kid=\"1-1-2-5\" data-name=\"navigation link item\" href=\"#\">\n                <i class=\"ti ti-rocket text-xl\" data-kid=\"1-1-2-5-1\" data-name=\"launchpad link icon\">\n                </i>\n                <span data-kid=\"1-1-2-5-2\" data-name=\"launchpad link text\">\n                    LaunchPad\n                </span>\n            </a>\n        </nav>\n        <div class=\"p-6 mt-auto border-t border-[#1E293B]\" data-kid=\"1-1-3\" data-name=\"sidebar status footer\">\n            <div class=\"glass-card rounded-2xl p-4\" data-kid=\"1-1-3-1\" data-name=\"system status card\">\n                <div class=\"flex items-center gap-3 mb-3\" data-kid=\"1-1-3-1-1\" data-name=\"status indicator group\">\n                    <div class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"1-1-3-1-1-1\" data-name=\"system status pulse orb\">\n                    </div>\n                    <span class=\"text-xs font-semibold uppercase tracking-wider text-slate-400\" data-kid=\"1-1-3-1-1-2\" data-name=\"status label text\">\n                        System Ready\n                    </span>\n                </div>\n                <div class=\"text-[11px] text-slate-500 font-mono leading-relaxed\" data-kid=\"1-1-3-1-2\" data-name=\"system info details\">\n                    ASP v2.4.0 active\n                    <br data-kid=\"1-1-3-1-2-1\" data-name=\"status line break\">\n                    Network: OKX X1 Testnet\n                </div>\n            </div>\n        </div>\n    </aside>\n    \n    <main class=\"flex-1 overflow-y-auto bg-[#0A0F1C] relative\" data-kid=\"1-2\" data-name=\"main content area\">\n        \n        <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none\" data-kid=\"1-2-1\" data-name=\"subtle decorative grid background\" style=\"background-image: radial-gradient(#94A3B8 1px, transparent 1px); background-size: 40px 40px;\">\n        </div>\n        <div class=\"relative z-10 max-w-4xl mx-auto px-12 pt-32 pb-20\" data-kid=\"1-2-2\" data-name=\"content wrapper container\">\n            \n            <div class=\"mb-12 text-center\" data-kid=\"1-2-2-1\" data-name=\"section header group\">\n                <h2 class=\"text-4xl font-bold font-space text-white mb-4 tracking-tight\" data-kid=\"1-2-2-1-1\" data-name=\"main page headline\">\n                    Initiate New Build\n                </h2>\n                <p class=\"text-slate-400 text-lg\" data-kid=\"1-2-2-1-2\" data-name=\"sub-headline text\">\n                    Define your vision. Our agentic collective handles the rest.\n                </p>\n            </div>\n            \n            <div class=\"glass-card rounded-3xl p-10 shadow-2xl relative\" data-kid=\"1-2-2-2\" data-name=\"command center card\">\n                <div class=\"absolute -top-6 -left-6 w-12 h-12 border-t-2 border-l-2 border-[#FF4D00]/50 rounded-tl-xl\" data-kid=\"1-2-2-2-1\" data-name=\"decorative top corner accent\">\n                </div>\n                <div class=\"absolute -bottom-6 -right-6 w-12 h-12 border-b-2 border-r-2 border-[#FF4D00]/50 rounded-br-xl\" data-kid=\"1-2-2-2-2\" data-name=\"decorative bottom corner accent\">\n                </div>\n                <div class=\"space-y-8\" data-kid=\"1-2-2-2-3\" data-name=\"command input group\">\n                    <div data-kid=\"1-2-2-2-3-1\" data-name=\"build input field group\">\n                        <label class=\"block text-sm font-semibold text-slate-300 uppercase tracking-[0.2em] mb-4\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"input label text\">\n                            What are you building?\n                        </label>\n                        <textarea class=\"w-full bg-[#0F172A]/50 border border-[#1E293B] rounded-2xl p-6 text-white text-lg placeholder:text-slate-600 focus:outline-hidden focus:border-[#FF4D00] focus:ring-4 focus:ring-[#FF4D00]/10 transition-all duration-300 min-h-[180px] resize-none\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"project description textarea\" placeholder=\"e.g. A decentralized identity aggregator for the OKX ecosystem with cross-chain support...\"></textarea>\n                    </div>\n                    \n                    <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-2-2-3-2\" data-name=\"suggestion chips group\">\n                        <span class=\"text-xs font-medium text-slate-500 mr-2 uppercase tracking-wider\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"suggestions label text\">\n                            Try:\n                        </span>\n                        <button class=\"px-4 py-2 rounded-full bg-slate-800/40 border border-slate-700/50 text-xs font-medium text-slate-400 hover:text-[#FF4D00] hover:border-[#FF4D00]/30 hover:bg-[#FF4D00]/5 transition-all\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"suggestion button 1\">\n                            DeFi Dashboard\n                        </button>\n                        <button class=\"px-4 py-2 rounded-full bg-slate-800/40 border border-slate-700/50 text-xs font-medium text-slate-400 hover:text-[#FF4D00] hover:border-[#FF4D00]/30 hover:bg-[#FF4D00]/5 transition-all\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"suggestion button 2\">\n                            NFT Marketplace\n                        </button>\n                        <button class=\"px-4 py-2 rounded-full bg-slate-800/40 border border-slate-700/50 text-xs font-medium text-slate-400 hover:text-[#FF4D00] hover:border-[#FF4D00]/30 hover:bg-[#FF4D00]/5 transition-all\" data-kid=\"1-2-2-2-3-2-4\" data-name=\"suggestion button 3\">\n                            DAO Tooling\n                        </button>\n                    </div>\n                    \n                    <div class=\"pt-6\" data-kid=\"1-2-2-2-3-3\" data-name=\"launch action group\">\n                        <button class=\"group w-full bg-[#FF4D00] hover:bg-[#FF5D14] text-white font-bold py-5 rounded-2xl flex items-center justify-center gap-3 text-xl transition-all duration-300 shadow-[0_0_40px_rgba(255,77,0,0.2)] hover:shadow-[0_0_60px_rgba(255,77,0,0.4)]\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"launch builderforge button\">\n                            <i class=\"ti ti-rocket text-2xl animate-pulse-subtle\" data-kid=\"1-2-2-2-3-3-1-1\" data-name=\"rocket action icon\">\n                            </i>\n                            <span data-kid=\"1-2-2-2-3-3-1-2\" data-name=\"launch button text\">\n                                Launch BuilderForge\n                            </span>\n                            <i class=\"ti ti-arrow-right text-xl opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all\" data-kid=\"1-2-2-2-3-3-1-3\" data-name=\"arrow action icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"mt-16 grid grid-cols-3 gap-8\" data-kid=\"1-2-2-3\" data-name=\"footer info grid\">\n                <div class=\"text-center px-4\" data-kid=\"1-2-2-3-1\" data-name=\"footer column 1\">\n                    <div class=\"w-10 h-10 rounded-full bg-slate-800/50 flex items-center justify-center mx-auto mb-4 border border-slate-700/50\" data-kid=\"1-2-2-3-1-1\" data-name=\"footer column 1 icon wrapper\">\n                        <i class=\"ti ti-search text-[#FF4D00]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"search feature icon\">\n                        </i>\n                    </div>\n                    <h4 class=\"text-sm font-semibold text-white mb-2\" data-kid=\"1-2-2-3-1-2\" data-name=\"footer column 1 title\">\n                        Deep Research\n                    </h4>\n                    <p class=\"text-xs text-slate-500 leading-relaxed\" data-kid=\"1-2-2-3-1-3\" data-name=\"footer column 1 description\">\n                        Agents analyze market data and OKX grants in real-time.\n                    </p>\n                </div>\n                <div class=\"text-center px-4\" data-kid=\"1-2-2-3-2\" data-name=\"footer column 2\">\n                    <div class=\"w-10 h-10 rounded-full bg-slate-800/50 flex items-center justify-center mx-auto mb-4 border border-slate-700/50\" data-kid=\"1-2-2-3-2-1\" data-name=\"footer column 2 icon wrapper\">\n                        <i class=\"ti ti-code text-[#FF4D00]\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"code feature icon\">\n                        </i>\n                    </div>\n                    <h4 class=\"text-sm font-semibold text-white mb-2\" data-kid=\"1-2-2-3-2-2\" data-name=\"footer column 2 title\">\n                        Auto-Codegen\n                    </h4>\n                    <p class=\"text-xs text-slate-500 leading-relaxed\" data-kid=\"1-2-2-3-2-3\" data-name=\"footer column 2 description\">\n                        Production-ready smart contracts and frontend scaffolding.\n                    </p>\n                </div>\n                <div class=\"text-center px-4\" data-kid=\"1-2-2-3-3\" data-name=\"footer column 3\">\n                    <div class=\"w-10 h-10 rounded-full bg-slate-800/50 flex items-center justify-center mx-auto mb-4 border border-slate-700/50\" data-kid=\"1-2-2-3-3-1\" data-name=\"footer column 3 icon wrapper\">\n                        <i class=\"ti ti-brand-blockchain text-[#FF4D00]\" data-kid=\"1-2-2-3-3-1-1\" data-name=\"blockchain feature icon\">\n                        </i>\n                    </div>\n                    <h4 class=\"text-sm font-semibold text-white mb-2\" data-kid=\"1-2-2-3-3-2\" data-name=\"footer column 3 title\">\n                        OKX Integration\n                    </h4>\n                    <p class=\"text-xs text-slate-500 leading-relaxed\" data-kid=\"1-2-2-3-3-3\" data-name=\"footer column 3 description\">\n                        One-click simulation and deployment to X1 testnet.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n",
