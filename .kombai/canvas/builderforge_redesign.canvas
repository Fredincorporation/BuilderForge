      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0F1C;\n    color: #E2E8F0;\n    font-family: 'Inter', sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-epilogue { font-family: 'Epilogue', sans-serif; }\n  \n  .glass-card {\n    background: rgba(30, 41, 59, 0.4);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    backdrop-filter: blur(8px);\n    transition: all 0.3s ease;\n  }\n  \n  .glass-card:hover {\n    border-color: rgba(255, 77, 0, 0.3);\n    box-shadow: 0 0 20px rgba(255, 77, 0, 0.05);\n  }\n\n  .sidebar-item:hover {\n    background: rgba(255, 255, 255, 0.03);\n  }\n  \n  .sidebar-item.active {\n    background: rgba(255, 77, 0, 0.1);\n    color: #FF4D00;\n  }\n\n  .step-line {\n    position: relative;\n  }\n  .step-line::after {\n    content: '';\n    position: absolute;\n    top: 2rem;\n    left: 50%;\n    width: 100%;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);\n    z-index: 0;\n  }\n</style>\n<div class=\"flex min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    \n    <aside class=\"w-64 border-r border-slate-800 flex flex-col bg-[#0A0F1C]\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"p-8\" data-kid=\"1-1-1\" data-name=\"brand logo area\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand name container\">\n                <div class=\"w-8 h-8 bg-[#FF4D00] rounded-md flex items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"logo background icon container\">\n                    <i class=\"ti ti-hammer text-white text-xl\" data-kid=\"1-1-1-1-1-1\" data-name=\"hammer icon\">\n                    </i>\n                </div>\n                <span class=\"font-epilogue font-bold text-xl tracking-tight text-white\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    BuilderForge\n                </span>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-4 space-y-1\" data-kid=\"1-1-2\" data-name=\"sidebar navigation menu\">\n            <div class=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest px-4 mb-4\" data-kid=\"1-1-2-1\" data-name=\"sidebar navigation header\">\n                Navigation\n            </div>\n            <a class=\"sidebar-item active flex items-center gap-3 px-4 py-2.5 rounded-md text-sm font-medium\" data-kid=\"1-1-2-2\" data-name=\"active sidebar link\" href=\"#\">\n                <i class=\"ti ti-home text-lg\" data-kid=\"1-1-2-2-1\" data-name=\"home icon\">\n                </i>\n                Home\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-2.5 rounded-md text-sm font-medium text-slate-400\" data-kid=\"1-1-2-3\" data-name=\"sidebar link\" href=\"#\">\n                <i class=\"ti ti-plus text-lg\" data-kid=\"1-1-2-3-1\" data-name=\"plus icon\">\n                </i>\n                New Project\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-2.5 rounded-md text-sm font-medium text-slate-400\" data-kid=\"1-1-2-4\" data-name=\"sidebar link\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"1-1-2-4-1\" data-name=\"dashboard icon\">\n                </i>\n                Dashboard\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-2.5 rounded-md text-sm font-medium text-slate-400\" data-kid=\"1-1-2-5\" data-name=\"sidebar link\" href=\"#\">\n                <i class=\"ti ti-briefcase text-lg\" data-kid=\"1-1-2-5-1\" data-name=\"briefcase icon\">\n                </i>\n                DealFlow\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-2.5 rounded-md text-sm font-medium text-slate-400\" data-kid=\"1-1-2-6\" data-name=\"sidebar link\" href=\"#\">\n                <i class=\"ti ti-rocket text-lg\" data-kid=\"1-1-2-6-1\" data-name=\"rocket icon\">\n                </i>\n                LaunchPad\n            </a>\n            <a class=\"sidebar-item flex items-center gap-3 px-4 py-2.5 rounded-md text-sm font-medium text-slate-400\" data-kid=\"1-1-2-7\" data-name=\"sidebar link\" href=\"#\">\n                <i class=\"ti ti-link text-lg\" data-kid=\"1-1-2-7-1\" data-name=\"link icon\">\n                </i>\n                OKX ASP Listing\n            </a>\n        </nav>\n        <div class=\"p-4 border-t border-slate-800\" data-kid=\"1-1-3\" data-name=\"system status container\">\n            <div class=\"bg-slate-900/50 rounded-lg p-4\" data-kid=\"1-1-3-1\" data-name=\"system status widget\">\n                <div class=\"flex items-center gap-2 mb-2\" data-kid=\"1-1-3-1-1\" data-name=\"system status header\">\n                    <div class=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\" data-kid=\"1-1-3-1-1-1\" data-name=\"status pulse indicator\">\n                    </div>\n                    <span class=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\" data-kid=\"1-1-3-1-1-2\" data-name=\"system status label\">\n                        System Online\n                    </span>\n                </div>\n                <div class=\"text-xs text-slate-400\" data-kid=\"1-1-3-1-2\" data-name=\"system version text\">\n                    v1.2.4 — Simulated Mode\n                </div>\n            </div>\n        </div>\n    </aside>\n    \n    <main class=\"flex-1 overflow-y-auto px-12 py-16 max-w-6xl mx-auto\" data-kid=\"1-2\" data-name=\"main content area\">\n        \n        <section class=\"text-center mb-24\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-[#FF4D00] text-xs font-medium mb-8\" data-kid=\"1-2-1-1\" data-name=\"hackathon badge\">\n                <span class=\"relative flex h-2 w-2\" data-kid=\"1-2-1-1-1\" data-name=\"pulse animation container\">\n                    <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FF4D00] opacity-75\" data-kid=\"1-2-1-1-1-1\" data-name=\"pinging badge ring\">\n                    </span>\n                    <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[#FF4D00]\" data-kid=\"1-2-1-1-1-2\" data-name=\"badge dot indicator\">\n                    </span>\n                </span>\n                OKX AI Genesis Hackathon MVP\n            </div>\n            <h1 class=\"font-epilogue text-6xl font-bold text-white mb-6 tracking-tight leading-tight\" data-kid=\"1-2-1-2\" data-name=\"hero headline text\">\n                BuilderForge\n            </h1>\n            <p class=\"text-xl text-slate-400 mb-10 max-w-2xl mx-auto font-light leading-relaxed\" data-kid=\"1-2-1-3\" data-name=\"hero description text\">\n                The Autonomous Idea-to-Launch Agent for the OKX Ecosystem. \n        Transform vision into architecture in seconds.\n            </p>\n            <div class=\"flex items-center justify-center gap-4\" data-kid=\"1-2-1-4\" data-name=\"hero action button group\">\n                <button class=\"bg-[#FF4D00] hover:bg-[#E64500] text-white px-8 py-4 rounded-md font-medium transition-all transform hover:-translate-y-0.5 shadow-lg shadow-orange-500/20\" data-kid=\"1-2-1-4-1\" data-name=\"primary action button\">\n                    Start New Project\n                </button>\n                <button class=\"bg-transparent border border-slate-700 hover:border-slate-500 text-slate-300 px-8 py-4 rounded-md font-medium transition-all\" data-kid=\"1-2-1-4-2\" data-name=\"secondary action button\">\n                    Explore DealFlow\n                </button>\n            </div>\n        </section>\n        \n        <section class=\"mb-32\" data-kid=\"1-2-2\" data-name=\"how it works section\">\n            <div class=\"text-center mb-16\" data-kid=\"1-2-2-1\" data-name=\"how it works header\">\n                <h2 class=\"font-epilogue text-sm font-bold text-[#FF4D00] uppercase tracking-[0.2em] mb-4\" data-kid=\"1-2-2-1-1\" data-name=\"section sub-headline\">\n                    Execution Pipeline\n                </h2>\n                <div class=\"h-px w-24 bg-gradient-to-r from-transparent via-[#FF4D00] to-transparent mx-auto\" data-kid=\"1-2-2-1-2\" data-name=\"decorative horizontal rule\">\n                </div>\n            </div>\n            <div class=\"flex justify-between items-start relative step-line\" data-kid=\"1-2-2-2\" data-name=\"process steps container\">\n                \n                <div class=\"flex flex-col items-center gap-4 w-1/5 relative z-10\" data-kid=\"1-2-2-2-1\" data-name=\"step card\">\n                    <div class=\"w-14 h-14 rounded-2xl glass-card flex items-center justify-center text-white border border-slate-700\" data-kid=\"1-2-2-2-1-1\" data-name=\"step icon wrapper\">\n                        <i class=\"ti ti-bulb text-2xl\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"bulb icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-sm font-medium text-white\" data-kid=\"1-2-2-2-1-2\" data-name=\"step label\">\n                        Idea Input\n                    </span>\n                </div>\n                \n                <div class=\"flex flex-col items-center gap-4 w-1/5 relative z-10\" data-kid=\"1-2-2-2-2\" data-name=\"step card\">\n                    <div class=\"w-14 h-14 rounded-2xl glass-card flex items-center justify-center text-slate-400 border border-slate-700\" data-kid=\"1-2-2-2-2-1\" data-name=\"step icon wrapper\">\n                        <i class=\"ti ti-search text-2xl\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"search icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-sm font-medium text-slate-400\" data-kid=\"1-2-2-2-2-2\" data-name=\"step label\">\n                        Research\n                    </span>\n                </div>\n                \n                <div class=\"flex flex-col items-center gap-4 w-1/5 relative z-10\" data-kid=\"1-2-2-2-3\" data-name=\"step card\">\n                    <div class=\"w-14 h-14 rounded-2xl glass-card flex items-center justify-center text-slate-400 border border-slate-700\" data-kid=\"1-2-2-2-3-1\" data-name=\"step icon wrapper\">\n                        <i class=\"ti ti-palette text-2xl\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"palette icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-sm font-medium text-slate-400\" data-kid=\"1-2-2-2-3-2\" data-name=\"step label\">\n                        Creation\n                    </span>\n                </div>\n                \n                <div class=\"flex flex-col items-center gap-4 w-1/5 relative z-10\" data-kid=\"1-2-2-2-4\" data-name=\"step card\">\n                    <div class=\"w-14 h-14 rounded-2xl glass-card flex items-center justify-center text-slate-400 border border-slate-700\" data-kid=\"1-2-2-2-4-1\" data-name=\"step icon wrapper\">\n                        <i class=\"ti ti-bolt text-2xl\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"bolt icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-sm font-medium text-slate-400\" data-kid=\"1-2-2-2-4-2\" data-name=\"step label\">\n                        Execution\n                    </span>\n                </div>\n                \n                <div class=\"flex flex-col items-center gap-4 w-1/5 relative z-10\" data-kid=\"1-2-2-2-5\" data-name=\"step card\">\n                    <div class=\"w-14 h-14 rounded-2xl glass-card flex items-center justify-center text-slate-400 border border-slate-700\" data-kid=\"1-2-2-2-5-1\" data-name=\"step icon wrapper\">\n                        <i class=\"ti ti-chart-bar text-2xl\" data-kid=\"1-2-2-2-5-1-1\" data-name=\"chart bar icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-sm font-medium text-slate-400\" data-kid=\"1-2-2-2-5-2\" data-name=\"step label\">\n                        Analysis\n                    </span>\n                </div>\n            </div>\n        </section>\n        \n        <section class=\"mb-32\" data-kid=\"1-2-3\" data-name=\"key features section\">\n            <div class=\"grid grid-cols-3 gap-6\" data-kid=\"1-2-3-1\" data-name=\"features grid container\">\n                <div class=\"glass-card p-8 rounded-xl group\" data-kid=\"1-2-3-1-1\" data-name=\"feature card\">\n                    <div class=\"w-10 h-10 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-[#FF4D00] mb-6 group-hover:scale-110 transition-transform\" data-kid=\"1-2-3-1-1-1\" data-name=\"feature icon wrapper\">\n                        <i class=\"ti ti-robot text-xl\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"robot icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-epilogue text-lg font-bold text-white mb-3\" data-kid=\"1-2-3-1-1-2\" data-name=\"feature title\">\n                        5 Specialized Agents\n                    </h3>\n                    <p class=\"text-sm text-slate-400 leading-relaxed\" data-kid=\"1-2-3-1-1-3\" data-name=\"feature description\">\n                        Coordinator, Researcher, Creator, Executor, and Analyzer work in perfect sync to handle the complexity of your deployment.\n                    </p>\n                </div>\n                <div class=\"glass-card p-8 rounded-xl group\" data-kid=\"1-2-3-1-2\" data-name=\"feature card\">\n                    <div class=\"w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 mb-6 group-hover:scale-110 transition-transform\" data-kid=\"1-2-3-1-2-1\" data-name=\"feature icon wrapper\">\n                        <i class=\"ti ti-binary text-xl\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"binary icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-epilogue text-lg font-bold text-white mb-3\" data-kid=\"1-2-3-1-2-2\" data-name=\"feature title\">\n                        OKX Testnet Integration\n                    </h3>\n                    <p class=\"text-sm text-slate-400 leading-relaxed\" data-kid=\"1-2-3-1-2-3\" data-name=\"feature description\">\n                        Simulate token deployment and smart contract interactions on OKC testnet with precision gas estimation.\n                    </p>\n                </div>\n                <div class=\"glass-card p-8 rounded-xl group\" data-kid=\"1-2-3-1-3\" data-name=\"feature card\">\n                    <div class=\"w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform\" data-kid=\"1-2-3-1-3-1\" data-name=\"feature icon wrapper\">\n                        <i class=\"ti ti-world text-xl\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"world icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-epilogue text-lg font-bold text-white mb-3\" data-kid=\"1-2-3-1-3-2\" data-name=\"feature title\">\n                        ASP Ready\n                    </h3>\n                    <p class=\"text-sm text-slate-400 leading-relaxed\" data-kid=\"1-2-3-1-3-3\" data-name=\"feature description\">\n                        Seamlessly list on the OKX.AI marketplace with pre-structured manifests and dynamic pricing capabilities.\n                    </p>\n                </div>\n            </div>\n        </section>\n        \n        <section class=\"border-t border-slate-800 pt-16\" data-kid=\"1-2-4\" data-name=\"tech stack section\">\n            <div class=\"flex flex-wrap items-center justify-center gap-12 opacity-40 hover:opacity-100 transition-opacity grayscale hover:grayscale-0\" data-kid=\"1-2-4-1\" data-name=\"tech stack list container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-1\" data-name=\"tech stack item\">\n                    <i class=\"ti ti-brand-python text-2xl\" data-kid=\"1-2-4-1-1-1\" data-name=\"python logo icon\">\n                    </i>\n                    <span class=\"font-epilogue text-sm font-semibold tracking-wider\" data-kid=\"1-2-4-1-1-2\" data-name=\"tech stack label\">\n                        PYTHON\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-2\" data-name=\"tech stack item\">\n                    <i class=\"ti ti-brain text-2xl\" data-kid=\"1-2-4-1-2-1\" data-name=\"crewai logo icon\">\n                    </i>\n                    <span class=\"font-epilogue text-sm font-semibold tracking-wider\" data-kid=\"1-2-4-1-2-2\" data-name=\"tech stack label\">\n                        CREWAI\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-3\" data-name=\"tech stack item\">\n                    <i class=\"ti ti-link text-2xl\" data-kid=\"1-2-4-1-3-1\" data-name=\"langchain logo icon\">\n                    </i>\n                    <span class=\"font-epilogue text-sm font-semibold tracking-wider\" data-kid=\"1-2-4-1-3-2\" data-name=\"tech stack label\">\n                        LANGCHAIN\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-4\" data-name=\"tech stack item\">\n                    <i class=\"ti ti-chart-dots text-2xl\" data-kid=\"1-2-4-1-4-1\" data-name=\"streamlit logo icon\">\n                    </i>\n                    <span class=\"font-epilogue text-sm font-semibold tracking-wider\" data-kid=\"1-2-4-1-4-2\" data-name=\"tech stack label\">\n                        STREAMLIT\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-5\" data-name=\"tech stack item\">\n                    <i class=\"ti ti-sparkles text-2xl\" data-kid=\"1-2-4-1-5-1\" data-name=\"claude logo icon\">\n                    </i>\n                    <span class=\"font-epilogue text-sm font-semibold tracking-wider\" data-kid=\"1-2-4-1-5-2\" data-name=\"tech stack label\">\n                        CLAUDE\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-6\" data-name=\"tech stack item\">\n                    <i class=\"ti ti-layers-intersect text-2xl\" data-kid=\"1-2-4-1-6-1\" data-name=\"okx web3 logo icon\">\n                    </i>\n                    <span class=\"font-epilogue text-sm font-semibold tracking-wider\" data-kid=\"1-2-4-1-6-2\" data-name=\"tech stack label\">\n                        OKX WEB3\n                    </span>\n                </div>\n            </div>\n        </section>\n        \n        <footer class=\"mt-32 pt-8 border-t border-slate-900 flex justify-between items-center text-slate-600 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"1-2-5\" data-name=\"footer container\">\n            <div data-kid=\"1-2-5-1\" data-name=\"copyright text\">\n                BuilderForge — AI Genesis Hackathon 2026\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"1-2-5-2\" data-name=\"footer links container\">\n                <a class=\"hover:text-slate-400\" data-kid=\"1-2-5-2-1\" data-name=\"footer navigation link\" href=\"#\">\n                    Documentation\n                </a>\n                <a class=\"hover:text-slate-400\" data-kid=\"1-2-5-2-2\" data-name=\"footer navigation link\" href=\"#\">\n                    GitHub\n                </a>\n                <a class=\"hover:text-slate-400\" data-kid=\"1-2-5-2-3\" data-name=\"footer navigation link\" href=\"#\">\n                    OKX.AI\n                </a>\n            </div>\n        </footer>\n    </main>\n</div>\n",
